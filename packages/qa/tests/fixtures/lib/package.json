{
  "name": "@jimka/typescript-ui",
  "exports": {
    "./core": {
      "import": "./dist/lib/core.es.js",
      "types": "./dist/lib/types/core/index.d.ts"
    },
    "./component/chart": {
      "import": "./dist/lib/component/chart.es.js",
      "types": "./dist/lib/types/component/chart/index.d.ts"
    },
    "./glyphs": {
      "import": "./dist/lib/glyphs/index.es.js",
      "types": "./dist/lib/types/glyphs/index.d.ts"
    },
    "./glyphs/solid": {
      "import": "./dist/lib/glyphs/solid/index.es.js",
      "types": "./dist/lib/types/glyphs/solid/index.d.ts"
    },
    "./glyphs/solid/*": {
      "import": "./dist/lib/glyphs/solid/*.es.js",
      "types": "./dist/lib/types/glyphs/solid/*.d.ts"
    },
    "./glyphs/*": {
      "import": "./dist/lib/glyphs/*.es.js",
