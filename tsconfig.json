{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noImplicitReturns": true,
        "noImplicitAny": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "removeComments": true,
        "paths": {
            "@jimka/typescript-ui": ["./src/typescript/lib/index.ts"],
            "~/*": ["./src/typescript/lib/*"]
        }
    }
}
